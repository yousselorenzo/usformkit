# ─────────────────────────────────────────────────────────────
# US Form Kit — environment variables
# Copy to .env.local for development. Set the same keys in Vercel
# (Project → Settings → Environment Variables) for production.
# ─────────────────────────────────────────────────────────────

# Public base URL (no trailing slash). Used for Stripe redirects, emails, sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Stripe ───────────────────────────────────────────────────
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# Not required for redirect-based Checkout (used here); kept for embedded
# Checkout / Stripe.js if you add it later.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# Dashboard → Developers → Webhooks → your endpoint → Signing secret
# Locally: `npm run stripe:listen` prints a whsec_… value.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── Document encryption ─────────────────────────────────────
# Form data is AES-256-GCM encrypted before it is attached to the Stripe
# session, so Stripe only ever stores ciphertext. Use 32+ random chars:
#   openssl rand -base64 48
# NEVER rotate this while unpaid/recent sessions exist (old links stop working).
DOCUMENT_ENCRYPTION_KEY=REPLACE_WITH_LONG_RANDOM_SECRET

# How many days the paid download link keeps working.
DOWNLOAD_WINDOW_DAYS=30

# ── Email (Resend — https://resend.com) ─────────────────────
RESEND_API_KEY=re_REPLACE_ME
# Must be a sender on a domain you verified in Resend.
EMAIL_FROM="US Form Kit <documents@usformkit.com>"
# Where new-order notifications go.
ADMIN_NOTIFICATION_EMAIL=vitalika.limited@gmail.com
# Attach the PDF to the customer email for W-9 orders too (contains SSN/EIN).
# Set to "false" to send only the secure download link for W-9s.
ATTACH_SENSITIVE_PDFS=true
